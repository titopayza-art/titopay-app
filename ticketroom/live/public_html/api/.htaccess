# TicketRoom API. Every request in here goes through index.php; the code,
# settings and database schema next to it are never served.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Apple Wallet's pass web service signs in with an Authorization header,
  # which some hosts (CGI, FastCGI) do not pass to PHP unless told to.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{REQUEST_URI} !/api/index\.php$
  RewriteRule ^ index.php [L,QSA]
</IfModule>
<FilesMatch "\.(php|sql|json|txt|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "^index\.php$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Allow from all
  </IfModule>
</FilesMatch>
