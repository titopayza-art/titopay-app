# TicketRoom configuration for Afrihost (cPanel "Setup Node.js App").
# 1. In File Manager, copy this file to ".env" in the same folder (ticketroom-app/.env).
# 2. Fill in the values marked CHANGE_ME. 3. Restart the app in Setup Node.js App.
# This file lives OUTSIDE public_html. Never upload .env into public_html.

NODE_ENV=production
PUBLIC_BASE_URL=https://ticketroom.co.za
TRUST_PROXY=true
COOKIE_SECURE=true
MIGRATE_ON_START=true

# --- Database (cPanel → PostgreSQL Databases). PostgreSQL 13+ required.
# Format: postgres://USER:PASSWORD@localhost:5432/DATABASE
# If your password has special characters (# @ : / ?), URL-encode them (e.g. # → %23, @ → %40).
DATABASE_URL=postgres://CHANGE_ME_user:CHANGE_ME_password@localhost:5432/CHANGE_ME_database

# --- First admin account. Created on first start ONLY if no admin exists yet.
# After you have signed in and changed the password, delete ADMIN_PASSWORD and restart.
ADMIN_EMAIL=hello@ticketroom.co.za
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=TicketRoom Admin

# --- Email (cPanel → Email Accounts → hello@ticketroom.co.za → Connect Devices shows these)
SMTP_HOST=mail.ticketroom.co.za
SMTP_PORT=465
SMTP_USER=hello@ticketroom.co.za
SMTP_PASS=CHANGE_ME
MAIL_FROM=TicketRoom <hello@ticketroom.co.za>

# --- Card payments. "none" = paid ticket sales stay closed (free events work).
# When you have a gateway account, switch to yoco or payfast and fill in its section.
PAYMENT_PROVIDER=none
# YOCO_ENV=live
# YOCO_SECRET_KEY=sk_live_...
# YOCO_WEBHOOK_SECRET=whsec_...
# PAYFAST_ENV=live
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=

# --- SMS: log (record only) | bulksms | clickatell
SMS_PROVIDER=log
SMS_SENDER_ID=TicketRoom
# BULKSMS_ENV=live
# BULKSMS_TOKEN_ID=
# BULKSMS_TOKEN_SECRET=
# CLICKATELL_ENV=live
# CLICKATELL_API_KEY=

# --- TitoPay wallet (off until TitoPay issues partner credentials)
TITOPAY_WALLET_ENABLED=false
# TITOPAY_ENV=live
# TITOPAY_CLIENT_ID=
# TITOPAY_CLIENT_SECRET=
# TITOPAY_WEBHOOK_SECRET=

# --- Fees (defaults shown)
BOOKING_FEE_CENTS=1000
ORGANISER_COMMISSION_BPS=500

# --- Security keys: leave empty. They are generated on first start and saved
# in ticketroom-app/var/secrets.json — BACK THAT FILE UP. Losing it invalidates
# every ticket QR code and tag.
# QR_SIGNING_KEY=
# TAG_PEPPER=
# DATA_ENCRYPTION_KEY=
# LINK_SIGNING_KEY=
