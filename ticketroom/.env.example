# TicketRoom environment. Copy to .env (never commit .env).
# Generate each key with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Every *_KEY / *_SECRET / *_PEPPER below is REQUIRED in production and must be unique per environment.

NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://ticketroom.co.za
TRUST_PROXY=true                 # true when behind a reverse proxy / Cloudflare
COOKIE_SECURE=true

# Dedicated database for TicketRoom (do NOT point at TitoPay's database).
# Use a role that does NOT own the tables in production (see docs/OPERATIONS.md).
DATABASE_URL=postgres://ticketroom_app:CHANGE_ME@db-host:5432/ticketroom
PG_POOL_MAX=20
MIGRATE_ON_START=false           # run `npm run migrate` as a deliberate deploy step instead
WORKERS=true                     # run background jobs in this process

# Cryptographic keys (64 hex chars each)
QR_SIGNING_KEY=
TAG_PEPPER=
DATA_ENCRYPTION_KEY=
LINK_SIGNING_KEY=

# Payments. Only "simulated" exists today and it is refused in production
# unless ALLOW_SIMULATED_PROVIDER=true (never do that with real customers).
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PROVIDER=false
SIM_PROVIDER_WEBHOOK_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# Buyer service fee per paid ticket: fixed cents + basis points of price
PLATFORM_FEE_FIXED_CENTS=300
PLATFORM_FEE_BPS=450
ORDER_HOLD_MINUTES=10

# Cashless (Mode A prepaid) limits, in cents
CASHLESS_MAX_BALANCE_CENTS=500000
CASHLESS_MIN_TOPUP_CENTS=2000
CASHLESS_MAX_TOPUP_CENTS=200000
POS_MAX_SALE_CENTS=300000
POS_PIN_THRESHOLD_CENTS=20000
UID_ONLY_MAX_SALE_CENTS=0        # UID-only tags cannot pay unless risk-accepted

# Messaging. Only "log" (records, does not send) exists today.
EMAIL_PROVIDER=log
SMS_PROVIDER=log
MAIL_FROM=TicketRoom <no-reply@ticketroom.co.za>
SMS_SENDER_ID=TicketRoom
SMS_COST_PER_SEGMENT_CENTS=25

# Retention (days)
RETENTION_WEBHOOK_PAYLOAD_DAYS=90
RETENTION_MESSAGE_DAYS=180
SESSION_DAYS=14

UPLOAD_DIR=/var/lib/ticketroom/uploads
