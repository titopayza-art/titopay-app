# TitoPay API configuration — NAMES ONLY, no values.
#
# Copy to .env on the server and fill in. .env is gitignored and is never
# included in api.zip, so extracting a release cannot overwrite your
# configuration.
#
# WHY THIS FILE EXISTS
#
# On 20 August 2026 a release added a newly REQUIRED variable. The new code
# correctly refused to start without it, the process exited, and nginx returned
# 502 with nothing to proxy to. Nothing had crashed and nothing was corrupt: the
# server simply had no way to know a new variable was needed until it restarted
# into the failure. This file is the declaration that was missing, and
# api/test/deployment-preflight.test.js fails the build if a required variable
# in src/config/env.js is ever absent from here again.
#
# Before restarting after any deploy, run:  node preflight.js
# It reads this configuration and tells you whether the new build will start.

# =============================================================================
# REQUIRED — the API refuses to start without these
# =============================================================================

# Postgres connection string. DATABASE_URL is accepted as an alternative.
POSTGRES_URL=

# Token signing keys. MINIMUM 32 BYTES EACH — shorter and the API will not
# start, because a guessable key means anyone can mint a token for any customer
# or admin. JWT_SECRET and REFRESH_TOKEN_SECRET are accepted as alternatives.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing either of these signs everyone out. Nothing is lost; they sign in again.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The key that South African ID and passport numbers are HMAC'd with, so a
# stolen database dump does not give them up. MINIMUM 32 BYTES.
#
# REQUIRED WHEN NODE_ENV=production. Outside production it is derived from
# JWT_ACCESS_SECRET so local work and tests need no extra setup.
#
# SET IT ONCE AND NEVER CHANGE IT. Identity hashes are computed with it, so
# rotating it makes every ID number verified under the old value stop matching.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IDENTITY_PEPPER=

# =============================================================================
# ENVIRONMENT — has a default, but set it deliberately in production
# =============================================================================

# "production" enables the production-only requirements above. Anything else is
# treated as a development environment.
NODE_ENV=
API_HOST=
API_PORT=
API_BASE_URL=

# Where the browser apps are served from. These drive CORS.
APP_ORIGIN=
ADMIN_ORIGIN=
HR_ORIGIN=
CORS_ORIGINS=
ALLOW_LOCAL_CORS_ORIGINS=

# How many proxies sit in front. On cPanel behind nginx this is normally
# "loopback". Getting it wrong makes rate limiting see one IP for everyone.
TRUST_PROXY=
GEO_COUNTRY_HEADER=

# =============================================================================
# SESSIONS, OTP AND LOCKOUT — all have safe defaults
# =============================================================================
COOKIE_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
SESSION_IDLE_TIMEOUT_SECONDS=
OTP_TTL_SECONDS=
MAX_OTP_ATTEMPTS=
MAX_OTP_RESENDS=
FAILED_LOGIN_LOCKOUT_THRESHOLD=
FAILED_LOGIN_LOCKOUT_SECONDS=
ADMIN_OTP_REQUIRED=
VERIFY_ADMIN_OTP=

# =============================================================================
# REGISTRATION GEO RULES
# =============================================================================
CUSTOMER_REGISTRATION_GEO_LOCK=
CUSTOMER_REGISTRATION_ALLOWED_COUNTRIES=
CUSTOMER_REGISTRATION_REQUIRE_SA_PHONE=

# =============================================================================
# EMAIL — transactional mail. Without it, email queues and is never sent.
# =============================================================================
EMAIL_PROVIDER=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_REJECT_UNAUTHORIZED=

# =============================================================================
# PEACH PAYMENTS — top-ups, checkout and payouts
# =============================================================================
PEACH_PAYMENTS_MODE=
PEACH_PAYMENTS_BASE_URL=
PEACH_PAYMENTS_SANDBOX_BASE_URL=
PEACH_PAYMENTS_PRODUCTION_BASE_URL=
PEACH_PAYMENTS_ENTITY_ID=
PEACH_PAYMENTS_MERCHANT_ID=
PEACH_PAYMENTS_CLIENT_ID=
PEACH_PAYMENTS_CLIENT_SECRET=
PEACH_PAYMENTS_API_KEY=
PEACH_PAYMENTS_API_SECRET=
PEACH_PAYMENTS_CALLBACK_URL=
PEACH_PAYMENTS_WEBHOOK_URL=
PEACH_PAYMENTS_WEBHOOK_SECRET=
PEACH_PAYMENTS_V2_ENABLED=

# =============================================================================
# DOCFOX — KYC verification
# =============================================================================
DOCFOX_MODE=
DOCFOX_BASE_URL=
DOCFOX_CLIENT_ID=
DOCFOX_CLIENT_SECRET=
DOCFOX_API_KEY=
DOCFOX_API_SECRET=
DOCFOX_CALLBACK_URL=
DOCFOX_WEBHOOK_SECRET=

# =============================================================================
# OTT — value-added services (airtime, data, electricity)
# =============================================================================
OTT_MODE=
OTT_BASE_URL=
OTT_MERCHANT_ID=
OTT_USERNAME=
OTT_PASSWORD=
OTT_API_KEY=
OTT_API_SECRET=
OTT_CALLBACK_URL=
OTT_WEBHOOK_SECRET=

# =============================================================================
# POS AND SCAN TO PAY
# =============================================================================
POS_MAX_AMOUNT=
POS_QR_EXPIRY_SECONDS=
POS_QR_LINK_BASE=
POS_SIGNATURE_TOLERANCE_SECONDS=
POS_TERMINAL_ENCRYPTION_KEY=
POS_PROVIDER_WEBHOOK_SECRET=

# =============================================================================
# SMS — configured but deliberately unused for customer messaging. TitoPay
# sends transactional communication in-app and by email only.
# =============================================================================
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=
SMS_CALLBACK_URL=
SMS_WEBHOOK_SECRET=

# =============================================================================
# VOICE AND VIDEO CALLING
# =============================================================================
STUN_URLS=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
