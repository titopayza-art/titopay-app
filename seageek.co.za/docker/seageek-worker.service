# systemd unit for the background worker on a VPS:
#   sudo cp docker/seageek-worker.service /etc/systemd/system/ && sudo systemctl enable --now seageek-worker
[Unit]
Description=SeaGeek worker (queued messages, email, webhooks, scheduled jobs)
After=network.target mysql.service

[Service]
User=www-data
WorkingDirectory=/var/www/seageek
ExecStart=/usr/bin/php /var/www/seageek/cli.php worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
